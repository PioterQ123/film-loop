<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Loop Video</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    background: #000;
    overflow: hidden;
}

video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
}
</style>
</head>

<body>

<video id="video" autoplay loop muted playsinline>
    <source src="./PioterQ_15s_loop_45s.mp4" type="video/mp4">
</video>

<script>
const video = document.getElementById("video");

video.muted = true;
video.loop = true;
video.autoplay = true;

video.play().catch(() => {
    document.addEventListener("click", () => {
        video.play();
    }, { once: true });
});
</script>

</body>
</html>
